---
import ArtifactStorageManager from '@/components/rebuild/ArtifactStorageManager.svelte'
import RebuildManager from '@/components/rebuild/RebuildManager.svelte'
import DashboardShell from '@/layouts/dashboard-shell.astro'
---

<DashboardShell title="Deploy Svelte Files" description="Publish browser-built Svelte Files safely.">
