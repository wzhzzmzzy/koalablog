---
import Page from '@/components/editor/Page.svelte'
import { readEditorCounts, readEditorFile, readEditorPrefix } from '@/db/editor'
import DashboardLayout from '@/layouts/dashboard.astro'

const url = Astro.url
const id = Number(url.searchParams.get('id') || '0')
const path = url.searchParams.get('path')
const env = Astro.locals.runtime?.env
const userId = Astro.locals.session.userId!
const [initialListing, initialCounts] = await Promise.all([
  readEditorPrefix(env, '/', userId),
  readEditorCounts(env, userId),
])
const target = id ? { id } : path ? { path } : null
const file = target
  ? initialListing.files.find(item => id ? item.id === id : item.path === path)
  ?? await readEditorFile(env, target, userId)
  : null

const userAgent = Astro.request.headers.get('user-agent') || ''
const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
---

<DashboardLayout title={`[Editor] ${file?.title ?? 'Files'}`} showHeader={false}>
  <Page client:load initialFile={file} {initialListing} {initialCounts} isMobile={isMobile} />
</DashboardLayout>
