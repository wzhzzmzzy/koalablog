---
import { Save, Upload } from '@lucide/astro'
import { actions } from 'astro:actions'
import ExportZip from '@/components/io/export-zip.svelte'
import ImportFile from '@/components/io/import-file.svelte'
import RssEnableSwitch from '@/components/settings/RssEnableSwitch.svelte'
import ThemeSwitch from '@/components/settings/theme-switch.svelte'
import { readToday } from '@/db/ossAccess'
import { listApiTokens, listUsers } from '@/db/user'
import DashboardShell from '@/layouts/dashboard-shell.astro'
import { globalConfig } from '@/lib/kv'

const saveResult = Astro.getActionResult(actions.form.settings)

const saved = saveResult && !saveResult.error
if (saved) {
  const config = await globalConfig(Astro.locals.runtime?.env || {})
  Astro.locals.config = config
}

const session = Astro.locals.session
const isAdmin = session.role === 'admin'
const env = Astro.locals.runtime?.env || {}

const apiTokens = session.userId ? await listApiTokens(env, session.userId) : []
const users = isAdmin ? await listUsers(env) : []

const pageConfig = Astro.locals.config.pageConfig
const rssConfig = Astro.locals.config.rss
const fontConfig = Astro.locals.config.font

const title = pageConfig.title ?? ''
const avatar = pageConfig.avatar ?? ''
const lightTheme = pageConfig.theme?.light ?? 'latte'
const darkTheme = pageConfig.theme?.dark ?? 'mocha'
const ossConfig = Astro.locals.config.oss
const ossAccess = isAdmin ? await readToday(Astro.locals.runtime?.env) : null

const inputClass = 'h-9 w-full min-w-0 rounded-lg border border-input bg-transparent px-3 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground hover:border-foreground/25 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50'
const primaryButtonClass = 'inline-flex h-8 items-center justify-center rounded-lg border border-transparent appearance-none bg-primary px-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50'
const secondaryButtonClass = 'inline-flex h-8 items-center justify-center rounded-lg border border-input appearance-none bg-transparent px-3 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50'
---

<DashboardShell title="Settings" description="Manage site configuration, access, and utilities.">
  <account-settings class="settings-page">
    <header class="settings-page-header">
      <div>
        <p class="settings-eyebrow">Dashboard</p>
        <h1>Settings</h1>
        <p>Manage access, site defaults, and workspace utilities from one place.</p>
      </div>
      {isAdmin && <span class="settings-page-status">Site administrator</span>}
    </header>

    <section class="settings-section" aria-labelledby="account-settings-title">
      <div class="settings-section-grid">
        <header class="settings-section-heading">
          <h2 id="account-settings-title">Account</h2>
          <p>Your password and personal API tokens.</p>
        </header>

        <div class="settings-section-content">
          <form data-account-action="changePassword" method="post" class="settings-list">
            <div class="settings-list-row">
              <div class="settings-row-copy">
                <label for="current-password">Current password</label>
                <p>Confirm your identity before choosing a new password.</p>
              </div>
              <div class="settings-row-control">
                <input class={inputClass} id="current-password" type="password" name="currentPassword" autocomplete="current-password" required />
              </div>
            </div>
            <div class="settings-list-row">
              <div class="settings-row-copy">
                <label for="new-password">New password</label>
                <p>Updating it signs all other sessions out.</p>
              </div>
              <div class="settings-row-control">
                <input class={inputClass} id="new-password" type="password" name="newPassword" autocomplete="new-password" required />
              </div>
            </div>
            <div class="settings-form-actions">
              <button class={primaryButtonClass}>Update password</button>
            </div>
          </form>

          <p class="dashboard-success-banner settings-notice hidden" role="status" data-feedback="changePassword">Password updated — your other sessions were signed out.</p>

          <div class="settings-subsection">
            <div class="settings-subsection-header">
              <div>
                <h3>API tokens</h3>
                <p>Create a scoped access token for scripts and integrations.</p>
              </div>
              <form data-account-action="createApiToken" method="post" class="settings-inline-form">
                <label class="sr-only" for="api-token-label">Token label</label>
                <input class={inputClass} id="api-token-label" type="text" name="label" placeholder="Token label (optional)" />
                <button class={secondaryButtonClass}>Create</button>
              </form>
            </div>

            {apiTokens.length > 0
              ? (
                  <ul class="settings-token-list">
                    {apiTokens.map(token => (
                      <li data-token-row={token.id}>
                        <span>{token.label || '(unlabeled)'}</span>
                        <button type="button" class={secondaryButtonClass} data-revoke-token={token.id}>Revoke</button>
                      </li>
                    ))}
                  </ul>
                )
              : <p class="settings-empty-state">No personal API tokens yet.</p>}

            <div class="settings-token-receipt hidden" data-new-token>
              <p>Copy this token now — it will not be shown again.</p>
              <div>
                <code data-new-token-value></code>
                <button type="button" class={secondaryButtonClass} data-copy-token>Copy</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {isAdmin && (
      <section class="settings-section" aria-labelledby="users-settings-title">
        <div class="settings-section-grid">
          <header class="settings-section-heading">
            <h2 id="users-settings-title">Users</h2>
            <p>Create accounts and reset their passwords.</p>
          </header>

          <div class="settings-section-content">
            <ul class="settings-user-list">
              {users.map(user => (
                <li>
                  <div class="settings-user-identity">
                    <span>{user.username}</span>
                    <span>{user.role}</span>
                  </div>
                  <form data-account-action="resetPassword" data-user-id={user.id} method="post" class="settings-inline-form">
                    <label class="sr-only" for={`reset-password-${user.id}`}>New password for {user.username}</label>
                    <input class={inputClass} id={`reset-password-${user.id}`} type="password" name="password" placeholder="New password" autocomplete="off" required />
                    <button class={secondaryButtonClass}>Reset</button>
                  </form>
                </li>
              ))}
            </ul>

            <div class="settings-subsection">
              <div class="settings-subsection-header">
                <div>
                  <h3>Add user</h3>
                  <p>New users can access their own account settings after signing in.</p>
                </div>
              </div>
              <form data-account-action="createUser" method="post" class="settings-create-user-form">
                <label class="sr-only" for="new-username">Username</label>
                <input class={inputClass} id="new-username" type="text" name="username" placeholder="Username" required />
                <label class="sr-only" for="new-user-password">Initial password</label>
                <input class={inputClass} id="new-user-password" type="password" name="password" placeholder="Initial password" autocomplete="off" required />
                <button class={primaryButtonClass}>Create user</button>
              </form>
            </div>
          </div>
        </div>
      </section>
    )}

    {isAdmin && (
      <setting-form class="block">
        <form id="settings-form" method="POST" action={actions.form.settings}>
          <section class="settings-section" aria-labelledby="site-settings-title">
            <div class="settings-section-grid">
              <header class="settings-section-heading">
                <h2 id="site-settings-title">Site</h2>
                <p>Changes in this section are saved as one site-wide configuration.</p>
              </header>

              <div class="settings-section-content">
                <div class="settings-site-actions">
                  <p>Review your changes, then save when you are ready.</p>
                  <button type="submit" class={primaryButtonClass}>
                    <Save size={16} />
                    Save changes
                  </button>
                </div>

                { saved && <p class="dashboard-success-banner settings-notice" role="status">Saved successfully.</p> }
                { saveResult?.error && <p class="settings-error-notice" role="alert">{saveResult.error.message}</p> }

                <section class="settings-subsection" aria-labelledby="general-settings-title">
                  <header class="settings-subsection-header">
                    <div>
                      <h3 id="general-settings-title">General</h3>
                      <p>Basic identity shown across the site.</p>
                    </div>
                  </header>
                  <div class="settings-list">
                    <div class="settings-list-row">
                      <div class="settings-row-copy">
                        <span>Blog identity</span>
                        <p>Set the title and avatar used in navigation and public pages.</p>
                      </div>
                      <div class="settings-row-control settings-field-stack">
                        <label class="settings-field-label" for="title-input">
                          <span>Blog title</span>
                          <input class={inputClass} id="title-input" name="title" value={title} />
                        </label>
                        <div class="settings-field-label">
                          <label for="avatar-input">Avatar URL</label>
                          <div class="settings-upload-control">
                            <input class={inputClass} id="avatar-input" name="avatar" value={avatar} />
                            <button type="button" id="upload-avatar-btn" class={secondaryButtonClass} aria-label="Upload avatar">
                              <Upload size={16} />
                              Upload
                            </button>
                          </div>
                        </div>
                        <p id="avatar-upload-status" class="hidden settings-inline-error" role="alert"></p>
                      </div>
                    </div>
                  </div>
                </section>

                <section class="settings-subsection" aria-labelledby="appearance-settings-title">
                  <header class="settings-subsection-header">
                    <div>
                      <h3 id="appearance-settings-title">Appearance</h3>
                      <p>Choose the Catppuccin flavor used in each system mode.</p>
                    </div>
                  </header>
                  <div class="settings-list">
                    <div class="settings-list-row">
                      <div class="settings-row-copy">
                        <span>Theme flavors</span>
                        <p>Preview and choose a light and dark default independently.</p>
                      </div>
                      <div class="settings-row-control">
                        <div id="theme-bus" class="hidden">
                          <input id="light" type="hidden" name="lightTheme" value={lightTheme} />
                          <input id="dark" type="hidden" name="darkTheme" value={darkTheme} />
                        </div>
                        <ThemeSwitch client:load light={lightTheme} dark={darkTheme} />
                      </div>
                    </div>
                  </div>
                </section>

                <section class="settings-subsection" aria-labelledby="storage-settings-title">
                  <header class="settings-subsection-header">
                    <div>
                      <h3 id="storage-settings-title">Object storage</h3>
                      <p>Set the monthly guardrails for reads and write operations.</p>
                    </div>
                    <p class="settings-usage-summary">Today: {ossAccess?.readTimes ?? 0} reads · {ossAccess?.operateTimes ?? 0} writes</p>
                  </header>
                  <div class="settings-list">
                    <div class="settings-list-row">
                      <div class="settings-row-copy">
                        <span>Monthly limits</span>
                        <p>Use 0 to disable a limit.</p>
                      </div>
                      <div class="settings-row-control settings-field-grid">
                        <label class="settings-field-label" for="read-limit-input">
                          <span>Read limit</span>
                          <input class={inputClass} id="read-limit-input" name="readLimit" value={ossConfig.readLimit} inputmode="numeric" />
                        </label>
                        <label class="settings-field-label" for="operate-limit-input">
                          <span>Write limit</span>
                          <input class={inputClass} id="operate-limit-input" name="operateLimit" value={ossConfig.operateLimit} inputmode="numeric" />
                        </label>
                      </div>
                    </div>
                  </div>
                </section>

                <section class="settings-subsection" aria-labelledby="rss-settings-title">
                  <header class="settings-subsection-header">
                    <div>
                      <h3 id="rss-settings-title">RSS</h3>
                      <p>Control the feed available to readers.</p>
                    </div>
                  </header>
                  <div class="settings-list">
                    <div class="settings-list-row">
                      <div class="settings-row-copy">
                        <span>Feed availability</span>
                        <p>Publish a discoverable RSS feed for this site.</p>
                      </div>
                      <div class="settings-row-control">
                        <RssEnableSwitch client:load checked={rssConfig?.enable || false} />
                      </div>
                    </div>
                    <div class="settings-list-row">
                      <div class="settings-row-copy">
                        <span>Feed metadata</span>
                        <p>Use a short description and BCP 47 language tag.</p>
                      </div>
                      <div class="settings-row-control settings-field-grid">
                        <label class="settings-field-label" for="rss-desc-input">
                          <span>Description</span>
                          <input class={inputClass} id="rss-desc-input" type="text" name="rssDesc" value={rssConfig?.description} />
                        </label>
                        <label class="settings-field-label" for="rss-lang-input">
                          <span>Language</span>
                          <input class={inputClass} id="rss-lang-input" type="text" name="rssLang" value={rssConfig?.lang || 'en-US'} />
                        </label>
                      </div>
                    </div>
                  </div>
                </section>

                <section class="settings-subsection" aria-labelledby="font-settings-title">
                  <header class="settings-subsection-header">
                    <div>
                      <h3 id="font-settings-title">Typography</h3>
                      <p>Optionally override the fonts used by readers and the editor.</p>
                    </div>
                  </header>
                  <div class="settings-list">
                    <div class="settings-list-row">
                      <div class="settings-row-copy">
                        <label for="font-cdn-input">Font source</label>
                        <p>Load a stylesheet before the configured font families are applied.</p>
                      </div>
                      <div class="settings-row-control">
                        <input class={inputClass} id="font-cdn-input" type="text" name="fontCDN" value={fontConfig?.cdn} placeholder="https://fonts.googleapis.com/css2?..." />
                      </div>
                    </div>
                    <div class="settings-list-row">
                      <div class="settings-row-copy">
                        <span>Font families</span>
                        <p>Each value accepts a CSS font-family stack.</p>
                      </div>
                      <div class="settings-row-control settings-font-grid">
                        <label class="settings-field-label" for="font-sans-input">
                          <span>Sans</span>
                          <input class={inputClass} id="font-sans-input" type="text" name="fontSans" value={fontConfig?.sans} placeholder="'Noto Sans SC', sans-serif" />
                        </label>
                        <label class="settings-field-label" for="font-serif-input">
                          <span>Serif</span>
                          <input class={inputClass} id="font-serif-input" type="text" name="fontSerif" value={fontConfig?.serif} placeholder="'Noto Serif SC', serif" />
                        </label>
                        <label class="settings-field-label" for="font-mono-input">
                          <span>Mono</span>
                          <input class={inputClass} id="font-mono-input" type="text" name="fontMono" value={fontConfig?.mono} placeholder="'JetBrains Mono', monospace" />
                        </label>
                      </div>
                    </div>
                  </div>
                </section>
              </div>
            </div>
          </section>
        </form>
      </setting-form>
    )}

    {isAdmin && (
      <section class="settings-section" aria-labelledby="settings-utility-title">
        <div class="settings-section-grid">
          <header class="settings-section-heading">
            <h2 id="settings-utility-title">Utilities</h2>
            <p>Import a local workspace or export a portable archive.</p>
          </header>
          <div class="settings-section-content">
            <ImportFile client:load />
            <ExportZip client:load />
          </div>
        </div>
      </section>
    )}
  </account-settings>
</DashboardShell>

<script>
import { actions } from 'astro:actions'

class AccountSettings extends HTMLElement {
  connectedCallback() {
    this.querySelectorAll<HTMLFormElement>('form[data-account-action]').forEach((form) => {
      form.addEventListener('submit', event => this.submit(event, form))
    })
    this.querySelectorAll<HTMLElement>('[data-revoke-token]').forEach((button) => {
      button.addEventListener('click', () => this.revoke(button))
    })
    this.querySelector('[data-copy-token]')?.addEventListener('click', () => this.copyToken())
  }

  showError(form: HTMLFormElement, message: string) {
    let errorEl = form.querySelector<HTMLParagraphElement>('p.error')
    if (!errorEl) {
      errorEl = document.createElement('p')
      errorEl.classList.add('error')
      form.insertAdjacentElement('beforeend', errorEl)
    }
    errorEl.textContent = message
  }

  async submit(event: Event, form: HTMLFormElement) {
    event.preventDefault()
    const actionName = form.dataset.accountAction
    const data = Object.fromEntries(new FormData(form))

    if (actionName === 'createApiToken') {
      const { data: created, error } = await actions.form.createApiToken(data as { label?: string })
      if (error) {
        this.showError(form, error.message)
        return
      }
      form.querySelector('p.error')?.remove()
      const block = this.querySelector<HTMLElement>('[data-new-token]')!
      this.querySelector<HTMLElement>('[data-new-token-value]')!.textContent = created?.token ?? ''
      block.classList.remove('hidden')
      form.reset()
      return
    }

    const result = actionName === 'changePassword'
      ? await actions.form.changePassword(data as { currentPassword: string, newPassword: string })
      : actionName === 'createUser'
        ? await actions.form.createUser(data as { username: string, password: string })
        : await actions.form.resetPassword({ userId: Number(form.dataset.userId), password: String(data.password || '') })

    if (result?.error) {
      this.showError(form, result.error.code === 'UNAUTHORIZED' ? 'Wrong current password' : result.error.message)
      return
    }

    form.querySelector('p.error')?.remove()

    if (actionName === 'changePassword') {
      this.querySelector('[data-feedback="changePassword"]')?.classList.remove('hidden')
      form.reset()
      return
    }

    window.location.reload()
  }

  async revoke(button: HTMLElement) {
    const id = Number(button.dataset.revokeToken)
    const { error } = await actions.form.revokeApiToken({ id })
    if (!error)
      button.closest('li')?.remove()
  }

  async copyToken() {
    const value = this.querySelector<HTMLElement>('[data-new-token-value]')?.textContent
    if (value)
      await navigator.clipboard.writeText(value)
  }
}

customElements.define('account-settings', AccountSettings)
</script>

<script>
import type { CatppuccinTheme } from '@/lib/const/config'
import { pickFileWithFileInput, uploadFile } from '@/lib/services/file-reader'

class SettingForm extends HTMLElement {
  formEl: HTMLFormElement
  avatarInputEl: HTMLInputElement
  uploadAvatarBtn: HTMLButtonElement
  avatarUploadStatusEl: HTMLParagraphElement
  themeBusEl: HTMLDivElement
  lightInputEl: HTMLInputElement
  darkInputEl: HTMLInputElement

  theme: {
    light: CatppuccinTheme
    dark: CatppuccinTheme
  }

  constructor() {
    super()
    this.formEl = this.querySelector('#settings-form')!
    this.avatarInputEl = this.querySelector('#avatar-input')!
    this.uploadAvatarBtn = this.querySelector('#upload-avatar-btn')!
    this.avatarUploadStatusEl = this.querySelector('#avatar-upload-status')!
    this.themeBusEl = this.querySelector('#theme-bus')!
    this.lightInputEl = this.querySelector('input#light')!
    this.darkInputEl = this.querySelector('input#dark')!

    this.onChangeTheme = this.onChangeTheme.bind(this)
    this.uploadAvatar = this.uploadAvatar.bind(this)

    this.uploadAvatarBtn.addEventListener('click', this.uploadAvatar)

    const light = this.lightInputEl.value as CatppuccinTheme
    const dark = this.darkInputEl.value as CatppuccinTheme
    this.theme = { light, dark }

    this.connectedCallback()
  }

  connectedCallback() {
    this.themeBusEl.addEventListener('update-theme', this.onChangeTheme)
  }

  disconnectedCallback() {
    this.themeBusEl.removeEventListener('update-theme', this.onChangeTheme)
    this.uploadAvatarBtn.removeEventListener('click', this.uploadAvatar)
  }

  onChangeTheme(event: CustomEvent<{ light: CatppuccinTheme, dark: CatppuccinTheme }>) {
    this.lightInputEl.value = event.detail.light
    this.darkInputEl.value = event.detail.dark
  }

  async uploadAvatar() {
    try {
      const files = await pickFileWithFileInput()
      if (!files || files.length === 0)
        return

      this.uploadAvatarBtn.disabled = true
      this.avatarUploadStatusEl.textContent = ''
      this.avatarUploadStatusEl.classList.add('hidden')
      const { data, error } = await uploadFile('oss', files)

      if (error) {
        console.error(error)
        this.showAvatarUploadError(`Upload failed: ${error.message}`)
      }
      else if (data) {
        const url = `/api/oss/${data.replace('/', '_')}`
        this.avatarInputEl.value = url
      }
    }
    catch (e) {
      console.error(e)
      this.showAvatarUploadError('Upload failed')
    }
    finally {
      this.uploadAvatarBtn.disabled = false
    }
  }

  showAvatarUploadError(message: string) {
    this.avatarUploadStatusEl.textContent = message
    this.avatarUploadStatusEl.classList.remove('hidden')
  }
}

customElements.define('setting-form', SettingForm)
</script>
