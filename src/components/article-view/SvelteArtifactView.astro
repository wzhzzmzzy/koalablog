---
interface Props {
  cssUrl: string
  moduleUrl: string
}

const { cssUrl, moduleUrl } = Astro.props
---

<link rel="stylesheet" href={cssUrl} />
<koala-artifact-mount>
  <section data-koala-artifact-root data-koala-artifact-module={moduleUrl} data-koala-render-state="loading">
    <p data-koala-artifact-status role="status">Loading application… <span>This application requires JavaScript.</span></p>
    <div data-koala-artifact-live hidden></div>
  </section>
</koala-artifact-mount>

<script>
import { mountPublicArtifact } from '@/lib/svelte/public-mount'

class KoalaArtifactMount extends HTMLElement {
  connectedCallback() {
    const root = this.querySelector('[data-koala-artifact-root]')
    if (!(root instanceof HTMLElement))
      return

    const status = root.querySelector<HTMLElement>('[data-koala-artifact-status]')
    const live = root.querySelector<HTMLElement>('[data-koala-artifact-live]')
    const moduleUrl = root.dataset.koalaArtifactModule
    if (!status || !live || !moduleUrl)
      return

    void mountPublicArtifact({
      importModule: url => import(/* @vite-ignore */ url),
      live,
      moduleUrl,
      root,
      status,
    })
  }
}

customElements.define('koala-artifact-mount', KoalaArtifactMount)
</script>
